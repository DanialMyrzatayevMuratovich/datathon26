# Без ключа всё работает: советы агента — по правилам. Настоящие значения — только в .env.local (в git не попадает).
# DEMO_MODE: auto — LLM, если заданы ключ и модель; 1 — всегда без LLM.
# В LLM уходят только агрегаты (метрики, имена колонок, счётчики), не строки данных.
DEMO_MODE=auto
LLM_API_KEY=
# OpenAI: https://api.openai.com/v1 · NVIDIA: https://integrate.api.nvidia.com/v1 · любой OpenAI-совместимый
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Optional second provider, used when the first one fails.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=
