# organizers' data: confidential, never in git (scripts/secret-scan.sh checks it too)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/demo/

# models are local per laptop / Drive; the leaderboard and reports are in git
models/*
!models/.gitkeep

# pitch exports are rebuilt from pitch/deck.md
pitch/*.pptx

# local tooling
scripts/timeline.local.sh
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/
.DS_Store
*.log

# laws: raw downloads and the big QA dump stay local (rebuild: see docs/LAWS.md)
data/laws/raw/*.html
data/laws/bank_law_qa.csv
